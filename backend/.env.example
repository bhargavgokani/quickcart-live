# ─── Environment ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB ──────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/quickcart

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# ─── Cookie ───────────────────────────────────────────────────
COOKIE_SECRET=your_cookie_secret_here

# ─── CORS ─────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
